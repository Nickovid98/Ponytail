# Plantilla de configuración. Copia este archivo a .env y rellena lo que necesites.
# Nunca subas .env a un repositorio: ya está en .gitignore.

# --- Claves ------------------------------------------------------------------
ANTHROPIC_API_KEY=
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALPHAVANTAGE_API_KEY=

# --- Modo de ejecución -------------------------------------------------------
# PAPER_TRADING=True   -> precios reales, órdenes simuladas, sin claves (empieza aquí)
# PAPER_TRADING=False  -> órdenes reales. Con EXCHANGE_SANDBOX=True van al entorno de
#                         pruebas del exchange; con False es dinero real y además hay
#                         que añadir CONFIRM_LIVE=SI_ARRIESGO_DINERO_REAL
PAPER_TRADING=True
EXCHANGE_SANDBOX=True
# EXCHANGE_ID=alpaca con SYMBOLS=BTC/USD,ETH/USD, QUOTE=USD y FEE_PCT=0.25: precios de Alpaca, solo simulación
EXCHANGE_ID=binanceusdm
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT

# --- Topstep (futuros con TopstepX). Solo si BROKER=topstepx ------------------
# Ejecutar SOLO en tu ordenador: Topstep no admite VPS, VPN ni acceso remoto.
# Con órdenes reales (PAPER_TRADING=False) hace falta además
# CONFIRM_LIVE=SI_ARRIESGO_DINERO_REAL
BROKER=ccxt
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=
TOPSTEPX_ACCOUNT_ID=
# Los dos importes son los de TU cuenta. Sin el primero el programa no arranca.
PROP_DAILY_LOSS_LIMIT_USD=
PROP_ACCOUNT_FLOOR_USD=
PROP_KILL_AT_PCT=75
PROP_MAX_CONTRACTS=1
MAX_TRADES_PER_DAY=10
PROP_LAST_ENTRY_CT=14:30
PROP_FLAT_BY_CT=15:00

# --- Riesgo y costes ---------------------------------------------------------
CAPITAL=3550
RISK_PER_TRADE_PCT=1.0
MAX_SL_PCT=5.0
DAILY_LOSS_LIMIT_PCT=3.0
TOTAL_LOSS_LIMIT_USD=500
MAX_LEVERAGE=3
MAX_OPEN_POSITIONS=2
FEE_PCT=0.075
SLIPPAGE_PCT=0.02
START_MODE=AUTO

# --- Claude y evolución ------------------------------------------------------
CLAUDE_MODEL=claude-opus-5-5
DAILY_TOKEN_BUDGET=200000
MAX_RULES=8
