# Copia este archivo a .env y rellena lo que necesites. Nunca subas .env a un repositorio.

# --- Modo de ejecución -------------------------------------------------------
# paper   = precios reales, órdenes simuladas, sin claves (empieza aquí)
# sandbox = órdenes reales en el entorno de pruebas del exchange (claves de prueba)
# live    = dinero real; además exige CONFIRM_LIVE=SI_ARRIESGO_DINERO_REAL
EXECUTION_MODE=paper
EXCHANGE_ID=binanceusdm
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT
# auto | testnet | demo. En Binance, "auto" usa Demo Trading (el testnet clásico de futuros ya no existe).
SANDBOX_KIND=auto
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSWORD=

# --- Riesgo ------------------------------------------------------------------
CAPITAL=3550
RISK_PER_TRADE_PCT=1.0
MAX_SL_PCT=5.0
DAILY_LOSS_LIMIT_PCT=3.0
TOTAL_LOSS_LIMIT_USD=500
MAX_LEVERAGE=3
MAX_OPEN_POSITIONS=2
START_MODE=AUTO

# --- Noticias y Claude (opcionales) ------------------------------------------
ALPHAVANTAGE_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
